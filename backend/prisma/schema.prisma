generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationType {
  RETAILER
  SUPPLIER
  AGRI_ONE
  LOGISTICS
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_CORRECTION
}

enum UserRole {
  RETAILER
  SUPPLIER
  ADMIN
  WAREHOUSE
  DELIVERY
  FINANCE
  SUPPORT
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum FulfillmentSource {
  MARKETPLACE
  AGRI_ONE_STOCK
}

enum OrderStatus {
  PLACED
  PARTIALLY_ACCEPTED
  ACCEPTED
  PARTIALLY_DISPATCHED
  DISPATCHED
  DELIVERED
  PARTIALLY_CANCELLED
  CANCELLED
  REJECTED
}

enum FulfillmentStatus {
  NEW
  ACCEPTED
  REJECTED
  PICKING
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum InventoryMovementType {
  RECEIPT
  ADJUSTMENT
  RESERVATION
  RELEASE
  DISPATCH
  RETURN
}

enum ShipmentStatus {
  READY_FOR_PICKUP
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RETURNING
  RETURNED
}

model Organization {
  id                    String              @id @default(cuid())
  name                  String
  type                  OrganizationType
  verificationStatus    VerificationStatus @default(PENDING)
  verificationReason   String?
  gstin                 String?             @unique
  phone                 String?
  email                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  users                 User[]
  offers                ProductOffer[]      @relation("OfferSeller")
  retailerOrders        CustomerOrder[]     @relation("RetailerOrders")
  sellingFulfillments   FulfillmentOrder[]  @relation("FulfillmentSeller")
  shipments             Shipment[]          @relation("CarrierOrganization")
  kycDocuments          KycDocument[]

  @@index([type, verificationStatus])
}

model User {
  id                 String        @id @default(cuid())
  organizationId     String?
  organization       Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  email              String        @unique
  phone              String?       @unique
  passwordHash       String
  name               String
  role               UserRole
  status             AccountStatus @default(ACTIVE)
  emailVerifiedAt    DateTime?
  phoneVerifiedAt    DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  auditEvents        AuditEvent[]
  inventoryMovements InventoryMovement[]
  assignedShipments  Shipment[]    @relation("ShipmentAssignee")

  @@index([organizationId, role])
}

model KycDocument {
  id               String   @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentType     String
  storageKey       String
  originalName     String
  mimeType         String
  reviewStatus     VerificationStatus @default(PENDING)
  reviewReason     String?
  createdAt        DateTime @default(now())

  @@index([organizationId, reviewStatus])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
}

model HomeCategoryCard {
  slug      String   @id
  imageUrl  String
  updatedAt DateTime @updatedAt
}

model Product {
  id              String        @id @default(cuid())
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id])
  brandId         String?
  brand           Brand?        @relation(fields: [brandId], references: [id], onDelete: SetNull)
  name            String
  slug            String        @unique
  description     String?
  imageUrl        String?
  packSize        String
  unit            String
  taxRate         Decimal       @default(0) @db.Decimal(5, 2)
  status          ProductStatus @default(PENDING_REVIEW)
  rejectionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  offers          ProductOffer[]

  @@index([categoryId, status])
  @@index([brandId, status])
  @@index([name])
}

model ProductOffer {
  id                   String             @id @default(cuid())
  productId            String
  product               Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellerOrganizationId String
  seller                Organization       @relation("OfferSeller", fields: [sellerOrganizationId], references: [id])
  source                FulfillmentSource
  sellerSku             String
  price                 Decimal            @db.Decimal(12, 2)
  mrp                   Decimal?           @db.Decimal(12, 2)
  minimumOrderQuantity  Int                @default(1)
  stockOnHand           Int                @default(0)
  reservedQuantity      Int                @default(0)
  commissionRate        Decimal            @default(0) @db.Decimal(5, 2)
  leadTimeDays          Int                @default(3)
  isActive              Boolean            @default(false)
  warehouseCode         String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  serviceAreas          OfferServiceArea[]
  orderLines            OrderLine[]
  movements             InventoryMovement[]

  @@unique([sellerOrganizationId, sellerSku])
  @@index([productId, isActive, source])
  @@index([sellerOrganizationId, isActive])
}

model OfferServiceArea {
  id          String      @id @default(cuid())
  offerId     String
  offer       ProductOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  pinCode     String

  @@unique([offerId, pinCode])
  @@index([pinCode])
}

model CustomerOrder {
  id              String             @id @default(cuid())
  orderNumber     String             @unique
  retailerId      String
  retailer        Organization       @relation("RetailerOrders", fields: [retailerId], references: [id])
  status          OrderStatus        @default(PLACED)
  deliveryName    String
  deliveryPhone   String
  deliveryAddress String
  deliveryArea    String
  deliveryDistrict String
  deliveryPinCode String
  idempotencyKey  String?
  subtotal        Decimal            @db.Decimal(12, 2)
  taxTotal        Decimal            @db.Decimal(12, 2)
  total           Decimal            @db.Decimal(12, 2)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  fulfillments    FulfillmentOrder[]
  payments        Payment[]

  @@index([retailerId, createdAt])
  @@index([status, createdAt])
  @@unique([retailerId, idempotencyKey])
}

model FulfillmentOrder {
  id                   String             @id @default(cuid())
  fulfillmentNumber    String             @unique
  customerOrderId      String
  customerOrder        CustomerOrder      @relation(fields: [customerOrderId], references: [id], onDelete: Cascade)
  sellerOrganizationId String
  seller                Organization       @relation("FulfillmentSeller", fields: [sellerOrganizationId], references: [id])
  source                FulfillmentSource
  status                FulfillmentStatus  @default(NEW)
  subtotal              Decimal            @db.Decimal(12, 2)
  taxTotal              Decimal            @db.Decimal(12, 2)
  total                 Decimal            @db.Decimal(12, 2)
  rejectionReason       String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  lines                 OrderLine[]
  shipment              Shipment?

  @@index([sellerOrganizationId, status, createdAt])
}

model OrderLine {
  id                    String          @id @default(cuid())
  fulfillmentOrderId    String
  fulfillmentOrder      FulfillmentOrder @relation(fields: [fulfillmentOrderId], references: [id], onDelete: Cascade)
  offerId               String
  offer                 ProductOffer    @relation(fields: [offerId], references: [id])
  productNameSnapshot   String
  skuSnapshot           String
  sourceSnapshot        FulfillmentSource
  unitPriceSnapshot     Decimal         @db.Decimal(12, 2)
  quantity              Int
  taxRateSnapshot       Decimal         @db.Decimal(5, 2)
  taxAmount             Decimal         @db.Decimal(12, 2)
  commissionRateSnapshot Decimal        @db.Decimal(5, 2)
  commissionAmount      Decimal         @db.Decimal(12, 2)
  lineTotal             Decimal         @db.Decimal(12, 2)

  @@index([offerId])
}

model InventoryMovement {
  id          String               @id @default(cuid())
  offerId     String
  offer       ProductOffer         @relation(fields: [offerId], references: [id])
  actorId     String?
  actor       User?                @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type        InventoryMovementType
  quantity    Int
  reason      String
  referenceId String?
  batchNumber String?
  expiresAt   DateTime?
  createdAt   DateTime             @default(now())

  @@index([offerId, createdAt])
  @@index([referenceId])
}

model Shipment {
  id                 String         @id @default(cuid())
  fulfillmentOrderId String         @unique
  fulfillmentOrder   FulfillmentOrder @relation(fields: [fulfillmentOrderId], references: [id], onDelete: Cascade)
  carrierId          String?
  carrier             Organization?  @relation("CarrierOrganization", fields: [carrierId], references: [id], onDelete: SetNull)
  assignedUserId     String?
  assignedUser       User?           @relation("ShipmentAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  trackingNumber     String?
  status             ShipmentStatus @default(READY_FOR_PICKUP)
  deliveredAt        DateTime?
  failureReason      String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  events             ShipmentEvent[]
}

model ShipmentEvent {
  id          String         @id @default(cuid())
  shipmentId  String
  shipment    Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status      ShipmentStatus
  note        String?
  occurredAt  DateTime      @default(now())

  @@index([shipmentId, occurredAt])
}

model Payment {
  id                   String        @id @default(cuid())
  customerOrderId      String
  customerOrder        CustomerOrder @relation(fields: [customerOrderId], references: [id], onDelete: Cascade)
  amount               Decimal       @db.Decimal(12, 2)
  status               PaymentStatus @default(PENDING)
  provider             String?
  providerReference    String?       @unique
  idempotencyKey       String        @unique
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([customerOrderId, status])
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}
