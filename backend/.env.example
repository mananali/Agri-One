NODE_ENV=development
ENABLE_TEST_RETAILER_LOGIN=false
TEST_RETAILER_PHONE=9876543210
PORT=3001
FRONTEND_ORIGINS=http://localhost:3000
DATABASE_BACKUP_DIR=private-backups
