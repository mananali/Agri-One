# PG_DUMP_PATH=C:\Program Files\PostgreSQL\16\bin\pg_dump.exe
DATABASE_URL=postgresql://agri_one:agri_one_dev@localhost:5432/agri_one?schema=public
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters-long
PII_ENCRYPTION_KEY=replace-with-a-random-64-character-hex-key
JWT_EXPIRES_IN=1d
